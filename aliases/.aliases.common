# fast Docker Compose
alias dc='docker compose'

# edit hosts file securely
alias hosts='sudoedit /etc/hosts'

# editor aliases
alias vim='nvim'
alias v='nvim'

# open file explorer
alias o='nautilus .'

# folder navigation
alias ~='cd ~'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias .....='cd ../../../..'
alias ......='cd ../../../../..'
alias .......='cd ../../../../../..'
alias ........='cd ../../../../../../..'

# node aliases
alias dev='npm run dev'
alias build='npm run build'
alias npmi='npm install'
alias npmtest='npm test'

# own all files recursively
alias fuckperms='sudo chown -R "$USER":"$USER" . && sudo chmod -R u+rwX,go+rX .'

# git aliases
alias ga='git add'
alias gamend='git commit --amend --no-edit'
alias gap='git add -p'
alias gb='git branch'
alias gc='git commit'
alias gca='git commit --amend'
alias gcb='git checkout -b'
alias gck='git checkout'
alias gco='git checkout'
alias gcm='git commit -m'
alias gd='git diff'
alias gdc='git diff --cached'
alias gf='git fetch'
alias gl='git log --oneline --decorate --graph --all'
alias gp='git push'
alias gpl='git pull'
alias gr='git restore'
alias grs='git restore --staged'
alias grb='git rebase -i'
alias gst='git status'
alias gss='git status --short'
alias gt='git tag'
alias gs='git switch'
alias gsc='git switch -c'
alias gft='git fetch --tags'
alias glt='git describe --abbrev=0 --tags'
alias gundo='git reset --soft HEAD~1'

# search string
function search() {
  [[ -n "$1" ]] || { echo "usage: search <text>" >&2; return 2; }
  if command -v rg >/dev/null 2>&1; then
    rg -n -- "$1" .
  else
    grep -RinF -- "$1" .
  fi
}

# search conflicts
function conflicts() {
  if command -v rg >/dev/null 2>&1; then
    rg '^(<{7}|={7}|>{7})' .
  else
    grep -RinE '^([<]{7}|[=]{7}|[>]{7})' .
  fi
}
